<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Замовлення піци"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Введіть ім'я або коментар:" />

        <EditText
            android:id="@+id/etInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Наприклад: Даня, без цибулі"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Тип піци:"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <CheckBox
            android:id="@+id/cbMargherita"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Маргарита" />

        <CheckBox
            android:id="@+id/cbPepperoni"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Пепероні" />

        <CheckBox
            android:id="@+id/cbHawaiian"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Гавайська" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Розмір:"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <CheckBox
            android:id="@+id/cbSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Мала (25 см)" />

        <CheckBox
            android:id="@+id/cbMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Середня (30 см)" />

        <CheckBox
            android:id="@+id/cbLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Велика (35 см)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Додатки:"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <CheckBox
            android:id="@+id/cbCheese"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Додатковий сир" />

        <CheckBox
            android:id="@+id/cbMushrooms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Гриби" />

        <CheckBox
            android:id="@+id/cbOlives"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Оливки" />

        <Button
            android:id="@+id/btnOk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ОК"
            android:layout_marginTop="18dp" />

    </LinearLayout>
</ScrollView>